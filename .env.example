# Copy this file to .env and fill in the values.

# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_token_here
# Server (guild) ID and the voice channel to display the timer in (e.g. "SERVER TIME").
# Enable Developer Mode in Discord, then right-click -> Copy ID.
GUILD_ID=000000000000000000
VOICE_CHANNEL_ID=000000000000000000

# --- Reforger logs (required) ---
# Directory the Reforger server's logs are readable at. Either:
#   * the profile/logs directory that contains logs_YYYY-MM-DD_HH-MM-SS/ folders, or
#   * a single session folder that directly contains console.log.
# For a remote bot, this is wherever your log-shipping (SFTP/mount/syslog) writes them.
REFORGER_LOG_DIR=/path/to/reforger/profile/logs

# --- Voice visibility (optional) ---
# false: update channel status without joining (no bot in the participant list).
# Requires View Channel, Set Voice Channel Status, and Manage Channels.
# true: join voice for AllCallTimers connection timers; requires Connect and the
# bot will be visible in voice. Discord cannot hide a connected participant.
JOIN_VOICE_CHANNEL=false

# --- Tuning (optional) ---
# End the session if no server heartbeat (FPS line) is seen for this long.
SESSION_STALE_SECONDS=120
# How often to refresh the voice-channel status text while a match is live.
STATUS_REFRESH_SECONDS=60
# LOG_LEVEL=INFO

# --- A2S liveness fallback (optional) ---
# If set, when logs go stale the bot queries A2S to decide whether the server is
# really down (end session) or just had a log-shipping hiccup (keep session).
# A2S_HOST=203.0.113.10
# A2S_PORT=17777

# --- Optional: three read-only text channels instead of voice-status mode ---
# Copy servers.example.json to servers.local.json first. See NOTIFICATIONS.md.
# Server 1 uses REFORGER_LOG_DIR above; Servers 2/3 start disabled.
# SERVERS_CONFIG=servers.local.json
# NOTIFICATION_STATE_DB=data/notifications.sqlite3

# --- Live SERVER STATS voice channels (optional) ---
# A read-only "SERVER STATS" category (pinned to the top) of locked voice
# channels shows: the live match timer per server (Classic / 3x Everon / Arland),
# total linked players Playing ArmA, and Users in VC. It replaces the old
# per-server timer categories, which are removed automatically on startup.
# These need no extra setup. Channel names update at most every 5 minutes
# (Discord rate-limits channel renames). Per-server tiles default to
# Classic / 3x Everon / Arland; override with STAT_LABEL_SERVER_1/_2/_3.
# STAT_LABEL_SERVER_1=Classic
# STAT_LABEL_SERVER_2=3x Everon
# STAT_LABEL_SERVER_3=Arland
#
# Optional Admins tile. Discord only exposes role membership with the Server
# Members privileged intent, and online status with the Presence intent — both
# must be enabled in the Discord Developer Portal (Bot -> Privileged Gateway
# Intents) AND here, or the bot will refuse to start.
# ADMIN_ROLE_ID=123456789012345678
# ENABLE_MEMBERS_INTENT=true          # required for any Admins count
# ENABLE_PRESENCE_INTENT=true         # plus this for an online-only count
# ADMIN_STATS_ONLINE_ONLY=true        # show "Admins Online" instead of total

# --- Database retention (optional; safe defaults shown) ---
# Raw dedup/event rows are pruned once their permanent totals are aggregated.
# Totals, kills, deaths, playtime, account links and checkpoints are never touched.
# POST_EVENT_RETENTION_DAYS=30
# COMBAT_EVENT_RETENTION_DAYS=30
# ANNOUNCEMENT_RETENTION_DAYS=7
# PLAYTIME_INTERVAL_RETENTION_DAYS=3
# MAINTENANCE_INTERVAL_SECONDS=21600
